# Supabase PostgreSQL: use connection details from Project Settings > Connect.
# This deployment's verified session pooler uses port 5432. Its transaction
# pooler on 6543 rejected this project's tenant. Never commit real credentials.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres

JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-2-pro
REPLICATE_IMAGE_ENABLED=true
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
ALIBABA_VIDEO_MODEL=wan2.6-i2v-flash
ALIBABA_VIDEO_ENABLED=true
ALIBABA_PROMPT_EXTEND=false
VIDEO_PRIMARY_PROVIDER=alibaba
# No compatible image-to-video fallback is implemented/configured by default.
VIDEO_FALLBACK_PROVIDER=

# Credit debits are internal units. Review provider costs before assigning paid
# package allocations. Current clip generation is one image-to-video clip (2–15s).
IMAGE_GENERATION_CREDITS=5
VIDEO_30S_CREDITS=40

# Keep [] until package credit allocations are calculated and approved. Set a
# JSON array of {key, name, priceNgn (>=10000), credits (>0)} when ready.
CREDIT_PACKAGES_JSON=[]
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/settings
