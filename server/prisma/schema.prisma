generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssetType {
  IMAGE
  VIDEO
  CHARACTER
  STORYBOARD
  OTHER
}

enum CreditTransactionType {
  GRANT
  PURCHASE
  GENERATION
  REFUND
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  role         UserRole @default(USER)
  onboardingCompleted Boolean @default(false)
  emailVerifiedAt DateTime?

  projects   Project[]
  assets     Asset[]
  characters Character[]
  images     Image[]
  storyboards Storyboard[]
  videos Video[]
  settings Settings?
  creditAccount CreditAccount?
  creditTransactions CreditTransaction[]
  payments Payment[]
  launchEmailLogs LaunchEmailLog[]
  generationPresets GenerationPreset[]
  emailVerification EmailVerification?
  passwordReset PasswordReset?
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerification {
  id             String   @id @default(cuid())
  userId         String   @unique
  codeHash       String
  salt           String
  attempts       Int      @default(0)
  expiresAt      DateTime
  lastSentAt     DateTime
  windowStartedAt DateTime
  resendCount    Int      @default(1)
  consumedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PasswordReset {
  id             String   @id @default(cuid())
  userId         String   @unique
  tokenHash      String   @unique
  expiresAt      DateTime
  requestedAt    DateTime
  windowStartedAt DateTime
  requestCount   Int      @default(1)
  consumedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model CreditAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id             String                @id @default(cuid())
  userId         String
  delta          Int
  type           CreditTransactionType
  reason         String
  idempotencyKey String                @unique
  generationId   String?
  paymentId      String?
  createdAt      DateTime              @default(now())
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([generationId])
  @@index([paymentId])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  reference   String   @unique
  packageKey  String
  amountMinor Int
  currency    String   @default("NGN")
  credits     Int
  status      String   @default("pending")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  script      String?
  status      ProjectStatus @default(DRAFT)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  assets     Asset[]
  characters Character[]
  images     Image[]
  videos Video[]
  storyboards Storyboard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Asset {
  id           String    @id @default(cuid())
  name         String
  type         AssetType
  url          String
  thumbnailUrl String?
  metadata     Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  isFavorite Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([type])
}

model Character {
  id          String  @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  metadata    Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
}

model Image {
  id           String  @id @default(cuid())
  name         String
  prompt       String?
  url          String
  thumbnailUrl String?
  metadata     Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  isFavorite Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
}

model Settings {
  id        String   @id @default(cuid())
  userId    String   @unique

  theme     String   @default("dark")
  language  String   @default("en")
  timezone  String   @default("Africa/Lagos")

  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Storyboard {
  id          String  @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  scenes      Json?
  metadata    Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
}

model Video {
  id           String  @id @default(cuid())
  name         String
  prompt       String?
  url          String
  thumbnailUrl String?
  duration     Int?
  metadata     Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  isFavorite Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
}

model LaunchEmailLog {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email             String
  campaign          String
  status            String   @default("PENDING")
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, campaign])
  @@index([campaign, status])
}

model GenerationPreset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  category  String   @default("Custom")
  settings  Json
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, category])
}
